	# E-posta, Let's Encrypt sertifika bildirimleri için (isteğe bağlı ama önerilir)
	email yildirimkamil977@gmail.com
}

dijitalpazarlamakurslari.com {
	encode gzip zstd

	# API istekleri backend'e
	handle /api/* {
		reverse_proxy backend:8001
	}

	# SEO: sitemap ve robots backend'den
	handle /sitemap.xml {
		rewrite * /api/seo/sitemap.xml
		reverse_proxy backend:8001
	}
	handle /robots.txt {
		rewrite * /api/seo/robots.txt
		reverse_proxy backend:8001
	}

	# SEO: ana sayfalar sunucuda hazır meta + şema ile gelir
	@seo path / /kurslar /kurslar/* /canli-grup-egitimleri /canli-grup-egitimleri/* /egitmen/* /hakkimda /iletisim
	handle @seo {
		rewrite * /api/seo/html?path={path}
		reverse_proxy backend:8001
	}

	# Diğer tüm istekler React frontend'e
	handle {
		reverse_proxy frontend:80
	}
}

# www -> apex yönlendirmesi (DNS www de sunucuya bakıyor)
www.dijitalpazarlamakurslari.com {
	redir https://dijitalpazarlamakurslari.com{uri} permanent
}
