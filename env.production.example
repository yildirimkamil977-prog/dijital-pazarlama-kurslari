# ==========================================================================
# PRODUCTION ENV ŞABLONU
# Sunucuda:  cp .env.production.example .env   ve aşağıdaki değerleri doldur.
# Bu dosya GitHub'a gider; GERÇEK SIR DEĞERLERİNİ buraya YAZMA.
# Gerçek değerleri sohbetteki mesajdan .env dosyasına kopyala.
# ==========================================================================

# --- Veritabanı (docker-compose içindeki mongo servisi) ---
MONGO_URL=mongodb://mongo:27017
DB_NAME=akademi

# --- Genel ---
CORS_ORIGINS=https://dijitalpazarlamakurslari.com
EMAIL_FROM_NAME=Kamil Yıldırım Akademi

# --- Sırlar (kendi değerlerini gir) ---
JWT_SECRET=CHANGE_ME
SETTINGS_ENCRYPTION_KEY=CHANGE_ME
WEBHOOK_CRON_SECRET=CHANGE_ME

# --- Admin (ilk açılışta bu hesap oluşturulur) ---
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# --- Resend (e-posta) ---
RESEND_API_KEY=CHANGE_ME
RESEND_FROM=noreply@dijitalpazarlamakurslari.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=CHANGE_ME

# --- Frontend build değişkenleri (compose build args için) ---
REACT_APP_BACKEND_URL=https://dijitalpazarlamakurslari.com
REACT_APP_GOOGLE_CLIENT_ID=CHANGE_ME
